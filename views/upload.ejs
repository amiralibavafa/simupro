<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>SimuPro | New Interview Mock</title>

    <!-- Tab Icon -->
    <link rel="icon" type="image/png" href="/img/icon_logo.png">
    <!-- Bootstrap CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <style>
        body {
            background-color: #f5f5f5;
            font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
        }
        .container {
            max-width: 600px;
            margin-top: 80px;
            background-color: #ffffff;
            padding: 40px;
            border-radius: 20px;
            box-shadow: 0 10px 25px rgba(0,0,0,0.08);
        }
        .btn-primary {
            background-color: #384B70;
            border-color: #384B70;
        }
        .btn-primary:hover {
            background-color: #2d3b5a;
            border-color: #2d3b5a;
        }
        label {
            font-weight: 600;
            color: #384B70;
        }
        textarea {
            resize: none;
        }
        h2 {
            color: #384B70;
            margin-bottom: 30px;
        }
        .logo {
            display: block;
            margin: 0 auto 20px auto;
            width: 160px; /* Change size if you want */
        }
    </style>
</head>
<body>
    <div class="container">
        <img src="/img/main_logo-removebg.jpg" alt="App Logo" class="logo">
        <h2 class="text-center">Try AI Interview Practice</h2>
        <form action="/submit" method="POST" enctype="multipart/form-data">
            <div class="mb-4">
                <label for="resume" class="form-label">Upload Your Resume</label>
                <input class="form-control" type="file" id="resume" name="resume" accept=".pdf,.doc,.docx" required>
            </div>

            <div class="mb-4">
                <label for="jobDescription" class="form-label">Paste Job Description</label>
                <textarea class="form-control" id="jobDescription" name="jobDescription" rows="8" placeholder="Paste the job description here..." required></textarea>
            </div>

            <div class="d-grid">
                <button type="submit" class="btn btn-primary btn-lg">Submit</button>
            </div>
        </form>
    </div>

    <!-- Bootstrap JS (optional) -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
